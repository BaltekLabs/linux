# AI Linux defconfig — Alpine-based initramfs system for QEMU / bare metal
# Based on x86_64_defconfig with AI subsystem and initramfs additions.
#
# Build:
#   make ai_defconfig
#   make INITRAMFS_SOURCE=rootfs isoimage -j$(nproc)
# Test:
#   qemu-system-x86_64 -cdrom arch/x86/boot/image.iso -m 512M -nographic

# ---- AI subsystem -------------------------------------------------------
CONFIG_AI_CORE=y
CONFIG_AI_PROC_INTERFACE=y
CONFIG_AI_BUILTIN_CLAWS=y

# ---- Initramfs (built-in rootfs with zstd compression) ------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="rootfs_dev_nodes.txt rootfs"
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
CONFIG_RD_ZSTD=y
CONFIG_TMPFS=y

# ---- Base system --------------------------------------------------------
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_KALLSYMS_ALL=y
CONFIG_SMP=y
CONFIG_HZ_1000=y

# ---- Networking ---------------------------------------------------------
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_SYN_COOKIES=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y

# ---- Virtio / QEMU NICs (virtio + e1000 for broad VM compatibility) -----
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_8139TOO=y
CONFIG_8139CP=y
CONFIG_PCNET32=y
CONFIG_NE2K_PCI=y

# ---- Storage / SCSI -----------------------------------------------------
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y

# ---- ISO 9660 (needed to boot from the ISO) -----------------------------
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# ---- Filesystems --------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_PROC_KCORE=y
CONFIG_AUTOFS_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y

# ---- EFI stub (bare metal boot) -----------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y

# ---- TTY / serial (for -nographic QEMU) ---------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_VIRTIO_CONSOLE=y

# ---- DRM / KMS (required for Wayland/sway) ------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_QXL=y
CONFIG_DRM_SIMPLEDRM=y
# DRM_VIRTIO_GPU already declared above under Virtio section

# ---- Input subsystem (keyboard, mouse, touchpad) -------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_UINPUT=y

# ---- PS/2 keyboard + mouse (standard in QEMU) ----------------------------
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y

# ---- USB host + HID (USB keyboard/mouse) ---------------------------------
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---- Virtio input (QEMU virtio keyboard/mouse) ---------------------------
CONFIG_VIRTIO_INPUT=y

# CONFIG_LEGACY_PTYS is not set

# ---- Modules (allow loadable modules so ai_core can be =m as well) ------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- Misc ---------------------------------------------------------------
CONFIG_ACPI_DOCK=y
CONFIG_HW_RANDOM=y
CONFIG_RTC_CLASS=y
# CONFIG_RTC_HCTOSYS is not set
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
