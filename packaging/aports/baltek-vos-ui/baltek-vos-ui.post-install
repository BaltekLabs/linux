#!/bin/sh
set -e

# Create the 'baltek' system user that owns the Wayland session.
# System user: no login shell, no home directory, no password.
if ! id -u baltek >/dev/null 2>&1; then
  adduser -S -D -H -s /sbin/nologin -h /var/lib/baltek baltek
fi

# Grant access to the DRM/KMS device (video) and seat management (seat).
# seatd uses the 'seat' group to control hardware access without root.
addgroup baltek seat  2>/dev/null || true
addgroup baltek video 2>/dev/null || true

# Install Python dependencies into the vos venv
if [ ! -d /opt/baltek/vos/venv ]; then
  python3 -m venv /opt/baltek/vos/venv
fi
/opt/baltek/vos/venv/bin/pip install --quiet \
  pygame psutil aiohttp

# Enable required OpenRC services
rc-update add seatd         default >/dev/null 2>&1 || true
rc-update add baltek-vos-ui default >/dev/null 2>&1 || true

exit 0
