pkgname=baltek-vos-ui
pkgver=0.1.0
pkgrel=0
pkgdesc="VoiceOS - Animated circle UI with Ollama LLM integration for Baltek DTE"
url="https://github.com/BaltekLabs/linux"
arch="noarch"
license="MIT"
depends="
  python3
  py3-pip
  py3-pygame
  py3-psutil
  py3-aiohttp
  ollama
  hyprland
  seatd
  wlroots
  mesa-dri-gallium
  libseat
  xdg-user-dirs
"
install="$pkgname.post-install $pkgname.post-deinstall"

# The VoiceOS source tarball is produced by packaging/scripts/bundle-source.sh.
# Run that script first, then 'abuild checksum' to update sha512sums.
# Installer scripts in files/ are copied flat into $srcdir by abuild.
source="
  baltek-vos-ui-${pkgver}.tar.gz
  files/baltek-vos-launch
  files/baltek-vos-ui.initd
  files/baltek-vos-app
  files/hyprland-vos.conf
"
sha512sums="SKIP"

builddir="$srcdir/baltek-vos-ui-${pkgver}"

build() { :; }

package() {
  # VoiceOS Python source → /opt/baltek/vos/
  install -d "$pkgdir/opt/baltek/vos"
  cp -r "$builddir/src/." "$pkgdir/opt/baltek/vos/"
  install -m 0644 "$builddir/requirements.txt" \
    "$pkgdir/opt/baltek/vos/requirements.txt"

  # Launcher scripts → /usr/local/sbin/
  install -d "$pkgdir/usr/local/sbin"
  install -m 0755 "$srcdir/baltek-vos-launch" \
    "$pkgdir/usr/local/sbin/baltek-vos-launch"
  install -m 0755 "$srcdir/baltek-vos-app" \
    "$pkgdir/usr/local/sbin/baltek-vos-app"

  # OpenRC service
  install -d "$pkgdir/etc/init.d"
  install -m 0755 "$srcdir/baltek-vos-ui.initd" \
    "$pkgdir/etc/init.d/baltek-vos-ui"

  # Hyprland kiosk config
  install -d "$pkgdir/etc/baltek"
  install -m 0644 "$srcdir/hyprland-vos.conf" \
    "$pkgdir/etc/baltek/hyprland-vos.conf"
}
