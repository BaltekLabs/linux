#!/bin/sh
# /init — first userspace process for the AI Linux system

# ------------------------------------------------------------------ #
# Core mounts                                                         #
# ------------------------------------------------------------------ #

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev

[ -c /dev/null ]  || mknod -m 666 /dev/null  c 1 3
[ -c /dev/zero ]  || mknod -m 666 /dev/zero  c 1 5
[ -c /dev/tty ]   || mknod -m 666 /dev/tty   c 5 0
[ -c /dev/tty1 ]  || mknod -m 600 /dev/tty1  c 4 1

mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

# Populate /dev from /sys — creates block devices (/dev/vda etc.)
mkdir -p /dev/input
if [ -x /sbin/mdev ]; then
    echo /sbin/mdev > /proc/sys/kernel/hotplug
    mdev -s
fi

# ------------------------------------------------------------------ #
# Persistent storage overlay                                          #
# Mount the GNOME Boxes virtual disk and overlay writable dirs so    #
# packages installed at first-boot survive across reboots.           #
# ------------------------------------------------------------------ #

PERSIST_DEV=""
for candidate in /dev/vda /dev/sda /dev/vdb /dev/sdb; do
    [ -b "$candidate" ] && { PERSIST_DEV="$candidate"; break; }
done

if [ -n "$PERSIST_DEV" ]; then
    # Format the whole disk as ext4 on very first run (no partition table needed)
    if ! blkid "$PERSIST_DEV" 2>/dev/null | grep -q "TYPE="; then
        echo "Formatting persistent disk $PERSIST_DEV ..." > /dev/tty1
        mkfs.ext4 -q -F "$PERSIST_DEV" 2>/dev/null
    fi

    mkdir -p /mnt/persist
    if mount "$PERSIST_DEV" /mnt/persist 2>/dev/null; then
        # Overlay each directory that apk installs packages into.
        # lowerdir = bundled initramfs content (read-only base)
        # upperdir = persistent disk (writes survive reboots)
        for dir in usr sbin bin lib etc; do
            mkdir -p "/mnt/persist/${dir}-upper" "/mnt/persist/${dir}-work"
            mount -t overlay overlay \
                -o "lowerdir=/${dir},upperdir=/mnt/persist/${dir}-upper,workdir=/mnt/persist/${dir}-work" \
                "/${dir}" 2>/dev/null || true
        done
    fi
fi

mkdir -p /run /tmp /var/log
chmod 1777 /tmp

mkdir -p /run/user/0
chmod 700 /run/user/0
export XDG_RUNTIME_DIR=/run/user/0

# ------------------------------------------------------------------ #
# Hostname + modules                                                  #
# ------------------------------------------------------------------ #

hostname ai-linux
modprobe ai_core    2>/dev/null || true
modprobe ai_proc    2>/dev/null || true
modprobe ai_claws   2>/dev/null || true

# ------------------------------------------------------------------ #
# Start aicore immediately                                            #
# ------------------------------------------------------------------ #

if [ -x /usr/sbin/aicore ]; then
    /usr/sbin/aicore 2>/var/log/aicore.log &
    sleep 1
fi

# ------------------------------------------------------------------ #
# Networking — fully in background                                    #
# ------------------------------------------------------------------ #

(
    ip link set lo up 2>/dev/null

    for i in $(seq 10); do
        NETIF=$(ls /sys/class/net/ 2>/dev/null | grep -v "^lo$" | head -1)
        [ -n "$NETIF" ] && break
        sleep 1
    done

    echo "[pci] $(ls /sys/bus/pci/devices/ 2>/dev/null | tr '\n' ' ')" >> /var/log/network.log
    dmesg 2>/dev/null | grep -iE "eth|virtio.net|e1000|8139|pcnet|network|nic" | tail -10 >> /var/log/network.log
    echo "[net] interfaces: $(ls /sys/class/net/ 2>/dev/null | tr '\n' ' ')" >> /var/log/network.log

    for iface in $(ls /sys/class/net/ 2>/dev/null | grep -v "^lo$"); do
        [ -e "/sys/class/net/$iface/device" ] || continue
        ip link set "$iface" up 2>/dev/null
        udhcpc -i "$iface" -t 10 -T 2 -q 2>>/var/log/network.log &
    done

    for i in $(seq 20); do
        ip route show 2>/dev/null | grep -q "^default" && break
        sleep 1
    done
    echo "[net] done. route: $(ip route show 2>/dev/null | head -1)" >> /var/log/network.log
) &

# ------------------------------------------------------------------ #
# tty2: interactive shell                                             #
# ------------------------------------------------------------------ #

[ -c /dev/tty2 ] || mknod -m 600 /dev/tty2 c 4 2

{
    printf '\033[2J\033[H'
    printf '\033[1;32m=== AI Linux — Shell (tty2) ===\033[0m\n'
    printf 'Alt+F1 \xe2\x86\x92 AI Chat   F1/F2 in VoS \xe2\x86\x92 switch tty\n\n'
} > /dev/tty2

while true; do
    sh -l < /dev/tty2 > /dev/tty2 2>&1
    sleep 1
done &

# ------------------------------------------------------------------ #
# tty3: first-boot setup, then VoS pygame UI                         #
# ------------------------------------------------------------------ #

[ -c /dev/tty3 ] || mknod -m 600 /dev/tty3 c 4 3

(
    if [ ! -f /etc/.gui-installed ]; then
        {
            printf '\033[2J\033[H'
            printf '\033[1;32m=== AI Linux — First Boot Setup ===\033[0m\n\n'
        } > /dev/tty3
        /usr/local/sbin/first-boot-gui.sh 2>&1 | tee /var/log/first-boot.log > /dev/tty3
    fi

    {
        printf '\033[2J\033[H'
        printf '\033[1;33m=== Starting VoS UI ===\033[0m\n'
    } > /dev/tty3

    while true; do
        /usr/local/sbin/start-vos < /dev/tty3 > /dev/tty3 2>/var/log/vos.log
        sleep 3
    done
) &

# ------------------------------------------------------------------ #
# tty1: AI chat interface (PID 1 main loop)                          #
# ------------------------------------------------------------------ #

export TERM=linux
export TERMINFO=/usr/share/terminfo

{
    printf '\033[2J\033[H'
    printf '\033[1;32m=== AI Linux ===\033[0m\n'
    printf 'Alt+F2 \xe2\x86\x92 Shell   F3 in VoS \xe2\x86\x92 switch back\n\n'
} > /dev/tty1

while true; do
    if [ -x /usr/bin/dte ]; then
        /usr/bin/dte < /dev/tty1 > /dev/tty1 2>&1
    else
        sh -l < /dev/tty1 > /dev/tty1 2>&1
    fi
    sleep 2
done
